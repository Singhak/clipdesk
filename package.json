{
  "name": "clipdesk",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "OBS for Reels - A Vertical Content Workspace for Desktop Creators",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:ext": "tsc && vite build -c vite.extension.config.ts && vite build -c vite.content.config.ts",
    "build:desktop": "tsc && vite build -c vite.electron.config.ts && vite build -c vite.electron-main.config.ts",
    "desktop": "npm run build:desktop && node scripts/run-electron.mjs",
    "desktop:start": "node scripts/run-electron.mjs",
    "dist:desktop": "npm run build:desktop && electron-builder --win",
    "dist:win": "npm run build:desktop && electron-builder --win",
    "release:win": "npm run build:desktop && electron-builder --win --publish always",
    "package:downloads": "node scripts/package-downloads.mjs",
    "package:all": "npm run build && npm run build:desktop && npm run build:ext && node scripts/package-downloads.mjs"
  },
  "dependencies": {
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@tailwindcss/vite": "^4.3.3",
    "@xenova/transformers": "^2.17.2",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.9",
    "ffmpeg-static": "^5.3.0",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.3.3",
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.13.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.2.4"
  },
  "author": "ClipDesk",
  "build": {
    "appId": "ai.ruh.clipdesk",
    "productName": "ClipDesk",
    "directories": {
      "output": "dist-desktop",
      "buildResources": "electron/build"
    },
    "files": [
      "dist-electron/**/*",
      "!dist-electron/**/*.map",
      "package.json",
      "!node_modules/**/*",
      "node_modules/uiohook-napi/**/*",
      "node_modules/ffmpeg-static/**/*",
      "node_modules/node-gyp-build/**/*"
    ],
    "asarUnpack": [
      "node_modules/uiohook-napi/**/*",
      "node_modules/ffmpeg-static/**/*"
    ],
    "electronDist": "node_modules/electron/dist",
    "win": {
      "target": [
        "nsis"
      ],
      "signtoolOptions": {
        "signingHashAlgorithms": [
          "sha256"
        ]
      }
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ClipDesk",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "msi": {
      "oneClick": false,
      "shortcutName": "ClipDesk",
      "artifactName": "${productName}-${version}.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.video",
      "extendInfo": {
        "NSCameraUsageDescription": "ClipDesk shows your camera in the recording.",
        "NSMicrophoneUsageDescription": "ClipDesk records your voice-over."
      }
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "AudioVideo"
    },
    "npmRebuild": false,
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "enableCookieEncryption": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Singhak",
        "repo": "clipdesk"
      }
    ]
  }
}
