{
  "manifest_version": 3,
  "name": "ClipDesk - Vertical Screen Recorder",
  "short_name": "ClipDesk",
  "key": "",
  "version": "1.1.0",
  "description": "Record a tab or your screen with your camera as a 9:16 Reel, Short or TikTok, with cursor follow and click zoom.",
  "minimum_chrome_version": "126",
  "action": {
    "default_popup": "popup.html",
    "default_title": "ClipDesk",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "tabCapture",
    "desktopCapture",
    "storage",
    "unlimitedStorage",
    "scripting",
    "activeTab"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "commands": {
    "toggle-pause": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "Pause or resume recording"
    },
    "stop-recording": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Stop and save recording"
    }
  }
}
